# Copy this file to ".env" (in this same backend folder) and fill in your
# real values below. NEVER share your actual .env file, commit it to GitHub,
# or paste its contents anywhere - it contains secret credentials.

AWS_ACCESS_KEY_ID=your_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=your-bucket-name-here
